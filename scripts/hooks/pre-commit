#!/usr/bin/env bash
# pre-commit —— 提交前防巨类体检（跑 scripts/check-file-size.sh）。
#
#   安装（每个 clone 一次）：  ./scripts/install-hooks.sh
#   应急绕过单次提交（不推荐）：git commit --no-verify
#
# 说明：走 core.hooksPath=scripts/hooks，钩子随代码入库、可版本化更新。
set -u

REPO_ROOT=$(git rev-parse --show-toplevel) || exit 1

# 「改一处，先看兄弟」——登记表与脚本都在同级的 IMServer 仓（三仓共用一份，避免三处抄）。
# 只 WARN 不拦；没有那个仓（只 clone 了本仓）就静默跳过。
SYMMETRY="$REPO_ROOT/../IMServer/scripts/check-symmetry.sh"
[ -x "$SYMMETRY" ] && "$SYMMETRY" --repo "IMProgram" || true

"$REPO_ROOT/scripts/check-file-size.sh"
status=$?

if [ "$status" -ne 0 ]; then
  echo ""
  echo "✗ pre-commit：有文件超预算，提交已拦。"
  echo "  正确处理：拆分（造协作对象 / 分文件 category / 抽纯逻辑 + 单测），见 CODING_STYLE.md §7——**别放宽阈值**。"
  echo "  应急绕过（仅限确有正当理由）：git commit --no-verify"
  exit 1
fi

exit 0
