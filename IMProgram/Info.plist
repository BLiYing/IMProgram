<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App 声明支持的本地化语言。系统框架自带按钮（QuickLook「完成」、UISearchBar「取消」、
	     UIAlert 系统项等）按「App 支持语言 ∩ 设备偏好语言」解析渲染语言；工程仅声明 en 时，
	     中文设备上这些系统文案会落英文（Done/Cancel）。此处补声明 zh-Hans 使其在中文设备下本地化为中文。 -->
	<key>CFBundleLocalizations</key>
	<array>
		<string>zh-Hans</string>
		<string>en</string>
	</array>
	<!-- 仅开发骨架：允许明文连接（当前用 ws://，未上 TLS）。
	     生产必须改回 wss:// 并删除本节（见 CONVENTIONS.md §一/§六 安全）。 -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<!-- 真机连局域网内自建后端（如 192.168.1.12:8080）需要本地网络授权：iOS 14+ 对 App 访问
	     192.168/10/172.16 等私有网段会弹窗确认。缺这条文案时弹窗没有理由说明、极易被顺手拒绝，
	     此后所有到局域网 IP 的连接静默失败（模拟器走 127.0.0.1 不受限，故只在真机复现；
	     重装 App 会重置该授权）。拒绝后可在 设置 → 隐私与安全性 → 本地网络 里重新打开。 -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>用于连接你在局域网内自建的 IM 服务器（开发调试）。</string>
	<!-- 相册/相机/保存权限（M4 富媒体：选图、拍摄、下载媒体到相册）。iOS 要求先声明用途文案再运行时申请。 -->
	<key>NSPhotoLibraryUsageDescription</key>
	<string>用于选择照片或视频发送给聊天对象。</string>
	<key>NSCameraUsageDescription</key>
	<string>用于拍摄照片或视频发送给聊天对象，以及视频通话。</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>用于发送语音消息、拍摄视频时录制声音，以及音视频通话。</string>
	<!-- audio：通话中切到后台不断音（im-rtc）。remote-notification：别的设备读过后，
	     「已读清通知」推送唤醒挂起中的 App 删掉已读的通知（PUSH_M5_DESIGN §3.5）。 -->
	<!-- 通信通知（发送人头像，PUSH_M5_DESIGN §3.6）：通知扩展用 INSendMessageIntent 改写通知，
	     主 App 须声明支持这种 intent，系统才按通信通知样式展示。 -->
	<key>NSUserActivityTypes</key>
	<array>
		<string>INSendMessageIntent</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>remote-notification</string>
	</array>
	<!-- 出口合规：只用标准协议加密（TLS/WSS、WebRTC DTLS-SRTP），无自研/非标准算法，声明为豁免，
	     TestFlight/App Store Connect 不再每个构建都弹「缺少出口合规证明」。 -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>用于将聊天中的图片或视频保存到你的相册。</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key>
					<string>Default Configuration</string>
					<key>UISceneDelegateClassName</key>
					<string>SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
</dict>
</plist>
